# Copie para .env (que não vai para o git). Valores só para desenvolvimento local.
POSTGRES_USER=budgets
POSTGRES_PASSWORD=troque-esta-senha-local

# Portas na máquina (mude se alguma já estiver em uso)
POSTGRES_PORT=54320
REDIS_CACHE_PORT=6379
REDIS_DATA_PORT=6380
ELASTICSEARCH_PORT=9200
API_PORT=3000

# Rastreamento de erros (opcional). Sem DSN, nada é enviado. Local: pnpm obs:up && pnpm obs:dsn
# (GlitchTip, compatível com o Sentry); em produção, o DSN do projeto no Sentry.
GLITCHTIP_PORT=8000
SENTRY_DSN=
VITE_SENTRY_DSN=
