<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Orçamentos (legada)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Orçamentos <span class="badge bg-warning text-dark">versão legada</span></a>
                @if (Context.Request.Cookies[Sessao.CookieNome] is { } nome)
                {
                    <span class="navbar-text">@nome · <a asp-page="/Login" asp-route-sair="1">trocar usuário</a></span>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
